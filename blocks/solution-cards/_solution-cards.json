{
  "definitions": [
    {
      "title": "Solution Cards Grid",
      "id": "solution-cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Solution Cards Grid",
              "model": "solution-cards",
              "filter": "solution-cards-filter",
              "item1": {
                "sling:resourceType": "core/franklin/components/block/v1/block/item",
                "name": "Solution Card",
                "model": "solution-cards-item",
                "cardImage": "",
                "cardImageAlt": "Alt text",
                "cardTitle": "Card Title",
                "cardDescription": "<p>Description</p>",
                "imagePosition": "auto",
                "cta_text": "Saber más",
                "cta_link": ""
              }
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "solution-cards",
      "fields": [
        {
          "component": "text",
          "name": "sectionTitle",
          "label": "Título de sección",
          "valueType": "string",
          "description": "Opcional. Si se informa, se renderiza antes de la lista de tarjetas."
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Opciones del bloque",
          "valueType": "string[]",
          "options": [
            {
              "name": "Layout",
              "children": [
                { "name": "Sin alternancia automática", "value": "no-alternate" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "solution-cards-item",
      "fields": [
        { "component": "reference", "name": "cardImage", "label": "Imagen", "valueType": "string", "multi": false, "required": true },
        { "component": "text", "name": "cardImageAlt", "label": "Texto alternativo", "valueType": "string", "required": true },
        { "component": "text", "name": "cardTitle", "label": "Título", "valueType": "string", "required": true },
        { "component": "richtext", "name": "cardDescription", "label": "Descripción", "valueType": "string", "required": true },
        {
          "component": "select",
          "name": "imagePosition",
          "label": "Posición de imagen",
          "valueType": "string",
          "value": "auto",
          "options": [
            { "name": "Automática", "value": "auto" },
            { "name": "Izquierda", "value": "left" },
            { "name": "Derecha", "value": "right" }
          ]
        },
        { "component": "text", "name": "cta_text", "label": "Texto CTA", "valueType": "string", "value": "Saber más" },
        { "component": "aem-content", "name": "cta_link", "label": "Enlace CTA", "valueType": "string" }
      ]
    }
  ],
  "filters": [
    {
      "id": "solution-cards-filter",
      "components": ["core/franklin/components/block/v1/block/item"]
    }
  ]
}
