{
  "definitions": [
    {
      "title": "Logo Carousel",
      "id": "logo-carousel",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Logo Carousel",
              "model": "logo-carousel",
              "filter": "logo-carousel-filter",
              "item1": {
                "sling:resourceType": "core/franklin/components/block/v1/block/item",
                "name": "Logo",
                "model": "logo-carousel-item",
                "logoImage": "/content/dam/cecabank/logos/placeholder.png",
                "logoImageAlt": "Logo"
              }
            }
          }
        }
      }
    }
  ],
  
  "models": [
    {
      "id": "logo-carousel",
      "fields": [
        {
          "component": "text",
          "name": "sectionTitle",
          "label": "Título de sección",
          "valueType": "string",
          "required": true
        },
        {
          "component": "boolean",
          "name": "autoplay",
          "label": "Rotación automática",
          "valueType": "boolean"
        }
      ]
    },
    {
      "id": "logo-carousel-item",
      "fields": [
        {
          "component": "reference",
          "name": "logoImage",
          "label": "Imagen del logo",
          "valueType": "string",
          "required": true
        },
        {
          "component": "text",
          "name": "logoImageAlt",
          "label": "Texto alternativo del logo",
          "valueType": "string",
          "required": true
        },
        {
          "component": "text",
          "name": "logoLink",
          "label": "Enlace del logo",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "logo-carousel-filter",
      "components": [
        "core/franklin/components/block/v1/block/item"
      ]
    }
  ]
}
